# Environment for your instance. Copy to .env next to compose.yaml and fill in.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# or: openssl rand -hex 32

# Database password. Required. It is spliced into a connection URL, so use
# only URL-safe characters (the generators above are safe).
POSTGRES_PASSWORD=

# Session signing secret for the admin portal. Required.
BETTER_AUTH_SECRET=

# Your public origin. Both must match the domain visitors use.
SITE_URL=https://your-domain.example
BETTER_AUTH_URL=https://your-domain.example

# Admin login, created automatically on first boot. These two apply only
# while no admin exists yet. Later changes happen in the admin portal, not
# here.
ADMIN_EMAIL=you@example.org
ADMIN_PASSWORD=

# Cloudflare Turnstile guards the contact form. The values below are
# Cloudflare's public test keys, which always pass. Create a real widget for
# your domain at https://dash.cloudflare.com/ (Turnstile, Managed mode).
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# IndexNow key: any 32-char hex string. After content edits the site pings
# Bing, Yandex, Seznam and Naver so they re-crawl. Leave empty to disable.
INDEXNOW_KEY=

# Optional: pin a release instead of following the v1 channel.
# APP_IMAGE=ghcr.io/leonbirkel/personal-website:v1.0.0

# Optional: Cloudflare Tunnel token for the tunnel profile.
# TUNNEL_TOKEN=
