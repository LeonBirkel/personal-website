# Copy to .env and fill in real values. Never commit .env.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# PostgreSQL connection (docker compose --profile db up -d for local dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/personal_website

# Better-Auth (admin portal at /admin). BETTER_AUTH_URL must match the origin
# the site is served from.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Public site origin. Optional in production: it defaults to the
# canonicalOrigin from site.config.json. Set it in dev or CI to run on
# another origin.
SITE_URL=http://localhost:3000

# Path to the instance config. Dev runs as the fictional example person. To
# develop against your own data, copy the example to ./site.config.json (it is
# gitignored) and point this line at it.
SITE_CONFIG_PATH=deploy/site.config.example.json

# Cloudflare Turnstile (contact form). The values below are Cloudflare's
# public test keys — they always pass. Replace in production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Seed admin user, applied only while no admin exists yet. Change the
# password later with scripts/set-admin-password.ts (see DEPLOYMENT.md).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# IndexNow key (host key file is served automatically at /<key>.txt).
# Generate: any 32-char hex string. Leave empty to disable pings (e.g. dev).
INDEXNOW_KEY=

# Directory for runtime uploads (portrait, publication PDFs)
UPLOADS_DIR=./uploads
