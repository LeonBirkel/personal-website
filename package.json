{
  "name": "personal-website",
  "version": "1.5.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "prisma migrate deploy && next dev",
    "build": "next build",
    "start": "next start",
    "check": "tsc --noEmit && eslint . && prettier --check . && stylelint \"src/**/*.css\"",
    "lint": "eslint .",
    "format": "prettier --write . && stylelint \"src/**/*.css\" --fix",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "db:reseed": "prisma migrate deploy && tsx prisma/reset-content.ts && tsx prisma/seed.ts",
    "schema": "tsx scripts/generate-config-schema.ts",
    "schema:check": "tsx scripts/generate-config-schema.ts --check",
    "config:validate": "tsx scripts/validate-site-config.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.26",
    "dotenv": "^17.4.2",
    "marked": "^18.2.1",
    "next": "^16.4.6",
    "png-to-ico": "^3.0.2",
    "prisma": "^7.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "schema-dts": "^2.1.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "jscpd": "^5.4.3",
    "prettier": "^3.10.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.5"
    }
  }
}
