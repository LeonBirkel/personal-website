{
  "extends": "stylelint-config-standard",
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": ["import", "theme", "plugin", "utility", "layer", "apply", "variant"]
      }
    ],
    "at-rule-no-deprecated": null,
    "import-notation": "string"
  },
  "ignoreFiles": ["node_modules/**", ".next/**", "src/generated/**"]
}
